// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScanResult {
  Waiting
  Scanning
  Success
  FoundCanonical
  WrongLanguage
  Blocked
  Error
}

model Site {
  id           Int        @id @default(autoincrement())
  url          String     @unique @db.VarChar(200)
  title        String?    @db.VarChar(60)
  description  String?    @db.VarChar(160)
  scanResult   ScanResult @default(Waiting)
  scanPriority Int?
  scanTime     DateTime?
  error        String?    @db.VarChar(60)
  canonicalId  Int?
  canonical    Site?      @relation("Canonical", fields: [canonicalId], references: [id])
  canonicalFor Site[]     @relation("Canonical")
  nextId       Int?
  next         Site?      @relation("Next", fields: [nextId], references: [id])
  nextFor      Site[]     @relation("Next")
  previousId   Int?
  previous     Site?      @relation("Previous", fields: [previousId], references: [id])
  previousFor  Site[]     @relation("Previous")
  privPolId    Int?
  privPol      Site?      @relation("PrivacyPolicy", fields: [privPolId], references: [id])
  privPolFor   Site[]     @relation("PrivacyPolicy")
  tosId        Int?
  tos          Site?      @relation("TermsOfService", fields: [tosId], references: [id])
  tosFor       Site[]     @relation("TermsOfService")
  linksTo      Site[]     @relation("Link")
  linkedFrom   Site[]     @relation("Link")
  terms        Term[]     @relation("Term")
}

model Host {
  id     Int    @id @default(autoincrement())
  host   String @unique @db.VarChar(200)
  robots String @db.VarChar(512000)
}

model Term {
  id    Int    @id @default(autoincrement())
  term  String @unique
  sites Site[] @relation("Term")
}
